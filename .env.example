# Токен НОВОГО бота от @BotFather. Токен бота раскроя сюда не переносить.
FURNITURE_BOT_TOKEN=
# Новый запуск через OpenRouter. Для прежнего прямого API: AI_PROVIDER=openai.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_DIALOGUE_MODEL=openai/gpt-4.1-mini
OPENROUTER_SKETCH_MODEL=openai/gpt-image-2
# При AI_PROVIDER=openrouter ключ OpenAI не требуется.
OPENAI_API_KEY=
# Модели можно сменить независимо. Доступ зависит от вашего аккаунта OpenAI.
DIALOGUE_MODEL=gpt-4.1-mini
SKETCH_MODEL=gpt-image-2
SKETCH_QUALITY=medium
SKETCH_SIZE=1536x1024
SKETCH_SERVICE_URL=http://127.0.0.1:8091
# configure.py заполняет этот внутренний ключ автоматически.
SKETCH_SERVICE_TOKEN=
SKETCH_HOST=127.0.0.1
SKETCH_PORT=8091
# Самостоятельный сервис анализа рисунка и уточнения заявки.
DIALOGUE_SERVICE_URL=http://127.0.0.1:8092
# configure.py создаёт отдельный внутренний ключ; это не ключ OpenRouter.
DIALOGUE_SERVICE_TOKEN=
DIALOGUE_HOST=127.0.0.1
DIALOGUE_PORT=8092
